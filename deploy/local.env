# Local stand-in for R2/S3: tools/range_server.py serving /home/user/store on :9000 (bucket "osm").
# For Cloudflare R2: SUNCHASER_S3_ENDPOINT=<account>.r2.cloudflarestorage.com, SUNCHASER_S3_USE_SSL=true,
# SUNCHASER_S3_REGION=auto, and an R2 API token's key id / secret.
export SUNCHASER_CATALOG=sqlite:/home/user/lakes/berlin.sqlite
export SUNCHASER_DATA_PATH=s3://osm/berlin/
export SUNCHASER_S3_ENDPOINT=127.0.0.1:9000
export SUNCHASER_S3_KEY_ID=local
export SUNCHASER_S3_SECRET=local
export SUNCHASER_S3_REGION=us-east-1
export SUNCHASER_S3_URL_STYLE=path
export SUNCHASER_S3_USE_SSL=false
